    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@scure/btc-signer": "1.8.1",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uqr": "0.1.3",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
